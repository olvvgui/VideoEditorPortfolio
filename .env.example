DATABASE_URL="file:./portfolio.db"
JWT_SECRET="replace-with-a-random-secret-of-at-least-32-characters"
ADMIN_EMAIL="admin@frame.studio"
ADMIN_PASSWORD="replace-with-a-strong-password"
PORT=3001
FRONTEND_ORIGIN="http://localhost:5173"
# Production: exact HTTPS origin, no path or trailing slash.
# Trusted reverse proxy IPs/CIDRs only; empty when connected directly.
TRUST_PROXY=""
SEED_DEMO=true
VITE_CONTACT_EMAIL="oi@frame.studio"
# Optional custom destination for the e-mail CTA. Use mailto: or an https URL.
# Example: mailto:oi@frame.studio?subject=Novo%20projeto
VITE_EMAIL_LINK=""
# Only digits, including country code. Example Brazil: 5511999999999.
# When empty, the main contact button uses e-mail instead.
VITE_WHATSAPP=""
# Optional text already filled in when opening WhatsApp.
VITE_WHATSAPP_MESSAGE="Olá! Quero conversar sobre um projeto de vídeo."
# Optional custom destination for WhatsApp. Takes precedence over number/message.
# Example: https://wa.me/5511999999999?text=Ol%C3%A1
VITE_WHATSAPP_LINK=""
# Social networks are optional. Leave empty to hide each icon.
VITE_INSTAGRAM=""
VITE_LINKEDIN=""
VITE_YOUTUBE=""
